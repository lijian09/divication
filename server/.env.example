# ========== 应用配置 ==========
NODE_ENV=development
PORT=3000
API_PREFIX=api

# ========== MySQL 数据库 ==========
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=lingyu
DB_PASSWORD=lingyu_dev_2026
DB_DATABASE=lingyu
DB_SYNCHRONIZE=false
DB_LOGGING=true

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========== JWT ==========
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ========== 微信小程序 ==========
WX_APPID=your-wechat-appid
WX_SECRET=your-wechat-secret

# ========== 微信支付 ==========
WX_PAY_MCH_ID=your-merchant-id
WX_PAY_API_V3_KEY=your-api-v3-key
WX_PAY_SERIAL_NO=your-serial-no
WX_PAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WX_PAY_NOTIFY_URL=https://api.example.com/api/payment/callback

# ========== AI 服务 ==========
AI_PROVIDER=claude
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=4096
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
